[Unit]
Description=Kirim antrean email Inventaris
After=postgresql.service

[Service]
Type=oneshot
User=inventaris
Group=inventaris
WorkingDirectory=/var/www/inventaris
EnvironmentFile=/etc/inventaris/inventaris.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/inventaris
ExecStart=/usr/local/bin/bun --conditions=react-server scripts/kirim-email.ts
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/inventaris
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027
